# Database — Vercel Postgres or Neon
DATABASE_URL="postgresql://user:password@host:5432/creatoranalytics?sslmode=require"

# NextAuth — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ──────────────────────────────────────────────────────────────────
# Stripe Connect OAuth (for connecting creator accounts)
STRIPE_CLIENT_ID="ca_xxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# ── Kit (ConvertKit) ─────────────────────────────────────────────────────────
# API key from https://app.convertkit.com/account_settings/advanced_settings
# (stored per-user in ConnectedAccount.apiKey, not here — this is just a doc note)

# ── ManyChat ─────────────────────────────────────────────────────────────────
# API token from https://manychat.com/settings/api
# (stored per-user in ConnectedAccount.apiKey)

# ── Calendly ─────────────────────────────────────────────────────────────────
# OAuth 2.0 Client credentials from https://developer.calendly.com/
CALENDLY_CLIENT_ID="your-calendly-client-id"
CALENDLY_CLIENT_SECRET="your-calendly-client-secret"

# ── Encryption ───────────────────────────────────────────────────────────────
# AES-256 key for encrypting stored tokens/API keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-character-hex-string-here"
