// Creator Funnel Analytics — Prisma Schema
// Source-agnostic design: adding Instagram/TikTok later = new enum value + rows, not schema restructure

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth models (NextAuth) ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          ConnectedAccount[]
  contacts          Contact[]
  funnelDefinitions FunnelDefinition[]
  funnels           Funnel[]
  sessions          AuthSession[]

  @@map("users")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Integration accounts ─────────────────────────────────────────────────────

model ConnectedAccount {
  id           String        @id @default(cuid())
  userId       String
  provider     Provider
  // Credentials — encrypt in application layer before writing, decrypt after reading
  accessToken  String?
  refreshToken String?
  apiKey       String?       // Kit and ManyChat use API key auth
  expiresAt    DateTime?
  status       AccountStatus @default(ACTIVE)
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@unique([userId, provider])
  @@index([userId])
  @@map("connected_accounts")
}

enum Provider {
  STRIPE
  KIT
  MANYCHAT
  CALENDLY
  // Extension point: INSTAGRAM, TIKTOK, STAN_STORE added here later
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

// ─── Contacts (unified person record across platforms) ───────────────────────

model Contact {
  id       String  @id @default(cuid())
  userId   String  // which creator's workspace
  email    String?
  name     String?

  // Platform-specific IDs — the join keys that let us unify one person
  stripeCustomerId  String?
  kitSubscriberId   String?
  manychatUserId    String?
  calendlyInviteeId String?

  currentStage  FunnelEventType?
  lifetimeValue Decimal          @default(0) @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  events FunnelEvent[]
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([userId, currentStage])
  @@map("contacts")
}

// ─── Core event log ──────────────────────────────────────────────────────────

model FunnelEvent {
  id         String          @id @default(cuid())
  contactId  String
  userId     String          // denormalized for efficient per-creator queries
  type       FunnelEventType
  source     EventSource
  timestamp  DateTime
  value      Decimal?        @db.Decimal(10, 2) // dollar amount for purchase/refund events
  contentRef String?         // nullable — e.g. YouTube video URL that was link-clicked
  metadata   Json?           // raw source payload (Stripe charge object, etc.)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
  @@index([userId, timestamp])
  @@index([userId, type])
  @@index([timestamp])
  @@map("funnel_events")
}

enum FunnelEventType {
  COMMENT
  DM_STARTED
  FREEBIE_CLAIMED
  LINK_CLICKED   // e.g. YouTube video link from DM — inferred from click, not YouTube API
  CALL_SCHEDULED
  CALL_COMPLETED
  CALL_NO_SHOW
  SUBSCRIBED
  PURCHASED
  UNSUBSCRIBED
  REFUNDED
}

enum EventSource {
  MANYCHAT
  KIT
  STRIPE
  CALENDLY
  // Extension point: INSTAGRAM, TIKTOK, YOUTUBE added here later
}

// ─── Visual funnel builder ────────────────────────────────────────────────────

model Funnel {
  id        String       @id @default(cuid())
  userId    String
  name      String       @default("Untitled Funnel")
  status    FunnelStatus @default(DRAFT)
  nodes     Json         @default("[]")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("funnels")
}

enum FunnelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─── Funnel definitions — data-driven, not hardcoded ─────────────────────────

model FunnelDefinition {
  id          String   @id @default(cuid())
  userId      String?  // null = system default seed; set = creator's custom funnel
  name        String
  description String?
  // Ordered array of FunnelEventType values — defines the stages in sequence.
  // Adding a new funnel type = INSERT a row, no code changes required.
  stages      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("funnel_definitions")
}

// ─── Sync audit log ──────────────────────────────────────────────────────────

model SyncLog {
  id                 String     @id @default(cuid())
  connectedAccountId String
  startedAt          DateTime   @default(now())
  completedAt        DateTime?
  status             SyncStatus
  eventsIngested     Int        @default(0)
  errors             Json?

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@index([startedAt])
  @@map("sync_logs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}
